# Squidward GLM-5.2 fork — trim Cursor indexing to active dev paths.
# Syntax: standard .gitignore globs. .gitignore is also respected.

# --- Static assets & legal ---
assets/
LICENSE
CODE_OF_CONDUCT.md

# --- Repo hygiene / lint / CI config (never edited for kernel work) ---
.codespellrc
.coveragerc
.isort.cfg
.pre-commit-config.yaml
.devcontainer/
.github/
.ruff_cache/

# --- Containers & vendored upstream ---
docker/
3rdparty/
proto/

# --- Upstream docs, examples, benchmarks (we use utilities/ + results/) ---
docs_new/

# --- Unrelated language stacks ---
sgl-model-gateway/
rust/

# --- Python runtime: non-AMD hardware backends ---
python/sglang/srt/hardware_backend/cpu/
python/sglang/srt/hardware_backend/mlx/
python/sglang/srt/hardware_backend/musa/
python/sglang/srt/hardware_backend/npu/
python/sglang/srt/hardware_backend/xpu/

# --- sgl-kernel: tests, benches, non-GPU backends ---
sgl-kernel/csrc/cpu/
sgl-kernel/csrc/musa/
sgl-kernel/csrc/metal/
sgl-kernel/csrc/mamba/
sgl-kernel/csrc/grammar/
sgl-kernel/csrc/infllm_v2/
